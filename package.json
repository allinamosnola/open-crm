{
  "name": "dental-crm",
  "version": "0.1.0",
  "private": true,
  "description": "CRM de un consultorio dental (Next.js + Supabase) con bot de WhatsApp (Claude)",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "playwright test",
    "bot:dev": "tsx --conditions=react-server scripts/wechaty-dev.ts",
    "bot:chat": "tsx --conditions=react-server scripts/bot-chat.ts",
    "eval:bot": "tsx scripts/eval-bot.ts",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "clinic:create": "tsx scripts/create-clinic.ts",
    "plan:set": "tsx scripts/set-plan.ts",
    "flag:set": "tsx scripts/set-flag.ts",
    "clinic:set-whatsapp": "tsx scripts/set-whatsapp.ts",
    "stripe:check": "tsx --conditions=react-server scripts/check-stripe-prices.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^11.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "tw-animate-css": "^1.4.0",
    "twilio": "^6.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.2",
    "qrcode-terminal": "^0.12.0",
    "shadcn": "^4.21.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wechaty": "^1.20.2",
    "wechaty-puppet-whatsapp": "^1.19.4"
  },
  "allowScripts": {
    "@swc/core@1.16.2": true,
    "leveldown@6.1.1": true,
    "protobufjs@7.6.6": true,
    "puppeteer@24.43.1": true
  }
}
