# --- Supabase (panel) ---
# Con `npx supabase start`, la CLI imprime estos valores (API URL, anon key y service_role key).
# Para el build sin Supabase local basta con valores ficticios.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: se salta la RLS. SOLO servidor (webhook de WhatsApp, invitar
# personal, scripts/create-clinic.ts). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp (Twilio) ---
# Account SID y Auth Token de la consola de Twilio. El Auth Token también valida
# la firma X-Twilio-Signature de los webhooks.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Número del sandbox de WhatsApp de Twilio (referencia). El número con el que
# responde cada consultorio es clinics.whatsapp_from; el seed ya se lo asigna al
# consultorio A. Para otro consultorio: scripts/create-clinic.ts --whatsapp-from.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# URL pública de la app, sin "/" final (en desarrollo, la de ngrok). Twilio firma
# esta URL y se usa para el statusCallback de los mensajes salientes.
PUBLIC_BASE_URL=https://tu-subdominio.ngrok-free.app

# --- Bot de WhatsApp (agente con Claude) ---
# API key de Anthropic. La usan el webhook, `npm run bot:chat` y `npm run eval:bot`
# (estos dos llaman a la API real y cuestan tokens).
ANTHROPIC_API_KEY=

# Modelo del agente (default claude-sonnet-5, $2/$10 por millón de tokens).
CLAUDE_MODEL=claude-sonnet-5

# Esfuerzo del modelo: low | medium | high | xhigh | max (default low, por latencia).
# Se llama CLAUDE_BOT_EFFORT y no CLAUDE_EFFORT para no chocar con otras herramientas de Claude.
CLAUDE_BOT_EFFORT=low

# --- Avisos por email a la recepción (Resend) ---
# Cuando el bot escala una conversación, avisa a clinics.reception_email. Requiere
# una API key de Resend y un remitente de un dominio verificado en Resend. Sin
# estas variables no se envía email (el aviso queda solo en el panel).
RESEND_API_KEY=
EMAIL_FROM="Consultorio <avisos@tu-dominio.com>"

# --- Desarrollo del bot (bot:chat y bot:dev) ---
# Consultorio con el que hablan el simulador (`npm run bot:chat`) y Wechaty
# (`npm run bot:dev`). Con el seed, el consultorio A:
DEV_CLINIC_ID=f0000000-0000-0000-0000-00000000000a

# Puppet de Wechaty (solo desarrollo; no requiere token, solo escanear el QR al iniciar).
WECHATY_PUPPET=wechaty-puppet-whatsapp

# Poner en "false" para ver la ventana de Chrome mientras se prueba
# (útil para depurar problemas de "Couldn't log in" al escanear el QR).
WECHATY_PUPPET_HEADLESS=true

# --- Errores (Sentry) ---
# DSN del proyecto de Sentry (se inyecta en el build; sin DSN el SDK no envía nada).
NEXT_PUBLIC_SENTRY_DSN=
# Solo para subir source maps durante el build (Vercel: marcar solo para "Build").
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Cobro (Stripe) ---
# Llave secreta (sk_test_... en pruebas). SOLO servidor.
STRIPE_SECRET_KEY=
# Secreto de firma del webhook /api/stripe/webhook (whsec_...). En local lo imprime
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=
# Los precios no van en variables: se buscan en Stripe por lookup_key. Hay que crearlos
# mensuales, en MXN y sin IVA (Stripe Tax lo suma al cobrar), con estas llaves:
#   citabot_basic 699 · citabot_pro 2,990 · citabot_plus 5,990
#   citabot_bot 899 (complemento de Básico) · citabot_extra_clinic 999 (consultorio extra de Plus)
# La lista vive en PRICE_KEYS (src/lib/stripe/subscription.ts).

# Aviso de privacidad: se enlaza en el Checkout de la landing, junto al botón de pagar.
NEXT_PUBLIC_PRIVACY_URL=
